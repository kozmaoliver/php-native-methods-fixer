{
    "name": "native-methods-fixer/native-methods-fixer",
    "description": "A fun package that normalizes PHP's inconsistent native function parameter orders",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "files": ["src/functions.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "NativeMethodsFixer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}